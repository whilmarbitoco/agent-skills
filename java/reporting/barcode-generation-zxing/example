package com.simplepos.reporting;

import com.google.zxing.*;
import com.google.zxing.client.j2se.BufferedImageLuminanceSource;
import com.google.zxing.qrcode.QRCodeWriter;
import javafx.embed.swing.SwingFXUtils;
import javafx.scene.image.Image;
import java.awt.image.BufferedImage;

public class BarcodeGenerator {

    public static Image generateQR(String data, int size) throws Exception {
        QRCodeWriter writer = new QRCodeWriter();
        var hints = Map.of(
            EncodeHintType.ERROR_CORRECTION, ErrorCorrectionLevel.M,
            EncodeHintType.MARGIN, 2
        );
        BitMatrix matrix = writer.encode(data, BarcodeFormat.QR_CODE, size, size, hints);
        BufferedImage buffered = new BufferedImage(size, size, BufferedImage.TYPE_INT_RGB);
        for (int x = 0; x < size; x++)
            for (int y = 0; y < size; y++)
                buffered.setRGB(x, y, matrix.get(x, y) ? 0x000000 : 0xFFFFFF);
        return SwingFXUtils.toFXImage(buffered, null);
    }

    public static Image generateCode128(String data, int width, int height) throws Exception {
        MultiFormatWriter writer = new MultiFormatWriter();
        BitMatrix matrix = writer.encode(data, BarcodeFormat.CODE_128, width, height);
        BufferedImage buffered = new BufferedImage(width, height, BufferedImage.TYPE_INT_RGB);
        for (int x = 0; x < width; x++)
            for (int y = 0; y < height; y++)
                buffered.setRGB(x, y, matrix.get(x, y) ? 0x000000 : 0xFFFFFF);
        return SwingFXUtils.toFXImage(buffered, null);
    }
}